{
  "name": "base-workbench",
  "version": "0.4.0",
  "description": "本地优先的基地工作台：工作日志、任务进度、设备台账与数据迁移。",
  "homepage": "https://m0ba.github.io/base-workbench/",
  "repository": {
    "type": "git",
    "url": "https://github.com/m0ba/base-workbench.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "electron": "electron .",
    "pack:mac": "npm run build && electron-builder --mac zip --arm64 --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "jszip": "^3.10.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "build": {
    "appId": "com.haozihao.baseworkbench",
    "productName": "基地工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "base-workbench-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "base-workbench-${version}-win.${ext}"
    },
    "portable": {
      "artifactName": "base-workbench-${version}-win.${ext}"
    }
  }
}
